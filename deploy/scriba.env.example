# Copia a /scriba/scriba.env (permisos 600, dueño root). Lo lee scriba.service y lo pasa como flags.
# Dirección de escucha: detrás del túnel, solo en loopback.
SCRIBA_LISTEN=127.0.0.1:8090
# URL pública de la instancia (enlaces de kb_open y el comando de conexión de los agentes).
SCRIBA_PUBLIC_URL=https://kb.example.org
# Zona horaria del journal.
SCRIBA_TZ=America/Bogota
