package web

import (
	"net/url"
	"strconv"
)

// graphPageView es la vista /grafo: canvas a toda el área, filtros, conteo y zoom (graph.js).
templ graphPageView(v graphView) {
	<div class="gmap full" data-grafo="/api/grafo">
		<canvas role="img" aria-label="Grafo de notas y sus enlaces"></canvas>
		<div class="gtip" hidden></div>
		<button type="button" class="menu-button graph-toggle" popovertarget="graph-filters" aria-controls="graph-filters" aria-label="Abrir filtros del grafo">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 5h16M7 12h10M10 19h4"></path></svg>
		</button>
		<form class="gfilters" id="graph-filters" popover="auto" hx-boost="false" aria-label="Filtros del grafo">
			<h2 class="eyebrow">Filtros</h2>
			<div class="gtypes">
				for _, t := range v.Types {
					<label>
						<input type="checkbox" name="tipo" value={ t.Key } checked/>
						<i class="gdot" data-k={ t.Key }></i>
						<span>{ t.Label }</span>
						<small>{ strconv.Itoa(t.N) }</small>
					</label>
				}
			</div>
			<label class="gorph">
				<span>Mostrar huérfanas <small>({ strconv.Itoa(v.Orphans) })</small></span>
				<input type="checkbox" name="huerfanas"/>
			</label>
			<h2 class="eyebrow">Visualización</h2>
			<label class="gslider">
				<span>Tamaño de nodos</span><output data-unit="x">1.0x</output>
				<input type="range" name="tam" min="0.5" max="2" step="0.1" value="1"/>
			</label>
			<label class="gslider">
				<span>Grosor de enlaces</span><output data-unit="px">1.0px</output>
				<input type="range" name="grosor" min="0.5" max="3" step="0.5" value="1"/>
			</label>
			<label class="gslider">
				<span>Distancia</span><output>120</output>
				<input type="range" name="dist" min="40" max="240" step="10" value="120"/>
			</label>
		</form>
		<p class="gcount"><i></i><span data-gcount>{ strconv.Itoa(v.Notes) } notas · { strconv.Itoa(v.Links) } enlaces</span></p>
		<div class="gzoom" role="group" aria-label="Zoom">
			<button type="button" data-z="in" aria-label="Acercar">+</button>
			<button type="button" data-z="out" aria-label="Alejar">−</button>
			<button type="button" data-z="fit">ajustar</button>
		</div>
	</div>
	<script src={ asset("graph.js") } defer></script>
}

// localGraph es el grafo de profundidad 1 del rail del lector.
templ localGraph(p string) {
	<section>
		<div class="ghead">
			<h2 class="eyebrow">Grafo local</h2>
			<a href="/grafo">Abrir grafo</a>
		</div>
		<div class="gmap local" data-grafo={ "/api/grafo?centro=" + url.QueryEscape(p) } data-centro={ p }>
			<canvas role="img" aria-label="Notas conectadas con esta"></canvas>
			<p class="gfoot" data-gcount>Profundidad 1</p>
		</div>
	</section>
	<script src={ asset("graph.js") } defer></script>
}
