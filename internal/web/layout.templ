package web

import "strconv"

// layout es el shell de la app: sidebar, barra superior con búsqueda y la vista.
templ layout(sh shell, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<div class="app">
				@sidebar(sh)
				<div class="main">
					<header class="top">
						<form class="search" action="/buscar" role="search">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
							<input
								id="q"
								type="search"
								name="q"
								placeholder="Buscar en la base de conocimiento"
								aria-label="Buscar"
								autocomplete="off"
								hx-get="/buscar"
								hx-trigger="input changed delay:150ms, search"
								hx-target="#resultados"
							/>
							<kbd>⌘K</kbd>
							<div class="results" id="resultados" aria-live="polite"></div>
						</form>
					</header>
					<main class="view">
						@content
					</main>
				</div>
			</div>
			<script>
				// ⌘K / Ctrl+K enfoca la búsqueda; Escape o un clic fuera cierran los resultados.
				(() => {
					const q = document.getElementById("q"), res = document.getElementById("resultados");
					document.addEventListener("keydown", (e) => {
						if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); q.focus(); q.select(); }
						else if (e.key === "Escape" && res.innerHTML) { res.innerHTML = ""; q.focus(); }
					});
					document.addEventListener("click", (e) => { if (!e.target.closest(".search")) res.innerHTML = ""; });
				})();
			</script>
		</body>
	</html>
}

templ sidebar(sh shell) {
	<aside class="side" aria-label="Navegación">
		<a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M28.6 5.4 6.6 24.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M30 3.6C26.4 4.2 23.2 6.8 21.4 10.2L22.9 11C24.9 8.2 27.4 5.8 30 3.6Z"/><path d="M32 18.6C28.6 17.4 24.6 16.4 21.2 16.4L12.6 21.2C11.6 21.8 11.8 23.2 13 23.2L19.4 21.6C19 23 19.4 24.4 20.8 25C22.4 25.8 23.4 27.2 25.2 27.6C27.4 28.1 29.8 28.7 32 29Z"/><path d="M23 16.8C21.2 15.1 18.9 14.2 16.9 14.4C16 14.5 15.9 15.6 16.7 15.9L20.4 17.6Z"/><path d="M2.4 28.9c1.7-1.1 3.1-.1 4.6-.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/></svg>Scriba</a>
		<div>
			<h2 class="eyebrow">Vistas</h2>
			<nav class="nav">
				<a href="/" class={ templ.KV("on", sh.Current == "") }>Actividad</a>
			</nav>
		</div>
		<div>
			<h2 class="eyebrow">Folios</h2>
			<nav class="tree" aria-label="Folios">
				@treeList(sh.Tree)
			</nav>
		</div>
	</aside>
}

// treeList pinta el árbol con <details>, sin JS; la ruta de la nota abierta llega con open.
templ treeList(nodes []treeNode) {
	for _, n := range nodes {
		if n.Dir {
			<details open?={ n.Open }>
				<summary title={ n.Path }><span class="lbl">{ n.Label }</span><span class="n">{ strconv.Itoa(n.N) }</span></summary>
				<div class="kids">
					@treeList(n.Children)
				</div>
			</details>
		} else if n.Current {
			<a href={ noteHref(n.Path) } aria-current="page" title={ n.Path }>{ n.Label }</a>
		} else {
			<a href={ noteHref(n.Path) } title={ n.Path }>{ n.Label }</a>
		}
	}
}
