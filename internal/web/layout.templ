package web

import "strconv"

// layout es el shell de la app: sidebar, barra superior con búsqueda y la vista.
templ layout(sh shell, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href={ asset("favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ asset("app.css") }/>
			<script src={ asset("htmx.min.js") } defer></script>
			<script src={ asset("live.js") } defer></script>
			<script src={ asset("theme.js") }></script>
		</head>
		<body
			if sh.View != "editor" {
				hx-boost:inherited="target:.view select:.view swap:outerHTML"
			}
		>
			<div class="app">
				@sidebar(sh)
				<div class="main">
					<header class="top">
						<form class="search" action="/buscar" role="search">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
							<input
								id="q"
								type="search"
								name="q"
								placeholder="Buscar en la base de conocimiento"
								aria-label="Buscar"
								autocomplete="off"
								hx-get="/buscar"
								hx-trigger="input changed delay:150ms, search"
								hx-target="#resultados"
							/>
							<kbd>⌘K</kbd>
							<div class="results" id="resultados" aria-live="polite"></div>
						</form>
						<a class="live-badge" id="live" hidden></a>
						@themeToggle()
					</header>
					<main class="view" tabindex="-1" hx-history-elt data-current={ sh.Current } data-view={ sh.View }>
						@content
					</main>
				</div>
			</div>
			<script>
				// ⌘K / Ctrl+K enfoca la búsqueda; Escape o un clic fuera cierran los resultados.
				(() => {
					const q = document.getElementById("q"), res = document.getElementById("resultados");
					document.addEventListener("keydown", (e) => {
						if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); q.focus(); q.select(); }
						else if (e.key === "Escape" && res.innerHTML) { res.innerHTML = ""; q.focus(); }
					});
					document.addEventListener("click", (e) => { if (!e.target.closest(".search")) res.innerHTML = ""; });
					// Navegación parcial (ADR-009): solo cambia .view; la sidebar se ajusta a la vista nueva.
					// Una respuesta sin .view (error en texto plano, JSON, estático) vaciaría la vista: recarga completa.
					document.addEventListener("htmx:before:swap", (e) => {
						const ctx = e.detail.ctx;
						if (!ctx.sourceElement?._htmx?.boosted || /<main[^>]*class="view"/.test(ctx.text || "")) return;
						e.preventDefault();
						location.href = ctx.request.action;
					});
					let restored = false;
					document.addEventListener("htmx:before:history:restore", () => { restored = true; });
					document.addEventListener("htmx:after:settle", (e) => {
						if (!e.target.matches?.(".view")) return; // la búsqueda en vivo también dispara settle
						const v = document.querySelector(".view"), cur = v.dataset.current, view = v.dataset.view;
						if (restored) v.scrollTop = 0; // atrás/adelante reusan el mismo .view (outerSync) con su scroll
						restored = false;
						if (!document.querySelector(".reader")) window.scribaLector?.abort();
						// El enlace pulsado pudo salir del DOM: el foco va a la vista nueva para que el lector de pantalla la lea.
						res.innerHTML = "";
						q.value = "";
						const f = document.activeElement;
						if (!f || f === document.body || !f.isConnected) v.focus({ preventScroll: true });
						document.querySelectorAll(".tree a[aria-current]").forEach((a) => a.removeAttribute("aria-current"));
						document.querySelectorAll(".nav a").forEach((a) => a.classList.toggle("on", !cur && a.dataset.v === view));
						const a = cur && document.querySelector(`.tree a[data-path="${CSS.escape(cur)}"]`);
						if (!a) return;
						a.setAttribute("aria-current", "page");
						a.classList.remove("unread");
						for (let d = a.closest("details"); d; d = d.parentElement.closest("details")) d.open = true;
					});
				})();
			</script>
		</body>
	</html>
}

templ sidebar(sh shell) {
	<aside class="side" aria-label="Navegación">
		<a class="brand" href="/">
			@templ.Raw(logoSVG)
			Scriba
		</a>
		<div>
			<h2 class="eyebrow">Vistas</h2>
			<nav class="nav">
				<a href="/" class={ templ.KV("on", sh.Current == "" && sh.View == "") } data-v="">
					<span class="vl">
						@templ.Raw(navActividadSVG)
						Actividad
					</span>
				</a>
				<a href="/grafo" class={ templ.KV("on", sh.View == "grafo") } data-v="grafo">
					<span class="vl">
						@templ.Raw(navGrafoSVG)
						Grafo
					</span>
				</a>
				<a href="/conectores" class={ templ.KV("on", sh.View == "conectores") } data-v="conectores">
					<span class="vl">
						@templ.Raw(navConectoresSVG)
						Conectores
					</span>
				</a>
				if sh.Agents {
					<a href="/agentes" class={ templ.KV("on", sh.View == "agentes") } data-v="agentes">
						<span class="vl">
							@templ.Raw(navAgentesSVG)
							Agentes
						</span>
					</a>
				}
			</nav>
		</div>
		<div>
			<h2 class="eyebrow">Folios</h2>
			<nav class="tree" aria-label="Folios">
				@treeList(sh.Tree)
			</nav>
		</div>
	</aside>
}

// treeList pinta el árbol con <details>, sin JS; la ruta de la nota abierta llega con open.
templ treeList(nodes []treeNode) {
	for _, n := range nodes {
		if n.Dir {
			<details open?={ n.Open }>
				<summary title={ n.Path }><span class="lbl">{ n.Label }</span><span class="n">{ strconv.Itoa(n.N) }</span></summary>
				<div class="kids">
					@treeList(n.Children)
				</div>
			</details>
		} else {
			<a
				href={ noteHref(n.Path) }
				data-path={ n.Path }
				if n.Unread || n.Writing {
					class={ templ.KV("unread", n.Unread), templ.KV("writing", n.Writing) }
				}
				if n.Current {
					aria-current="page"
				}
				title={ n.Path }
			>{ n.Label }</a>
		}
	}
}
